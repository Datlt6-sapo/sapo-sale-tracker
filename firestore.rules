rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email; }
    function isSapo() { return signedIn() && myEmail().matches('.*@sapo[.]vn$'); }
    function userExists() { return exists(/databases/$(database)/documents/users/$(myEmail())); }
    function myRole() { return get(/databases/$(database)/documents/users/$(myEmail())).data.role; }
    function isUser() { return isSapo() && userExists(); }
    function isLeader() { return isUser() && myRole() == 'LEADER'; }

    // Users: ai cũng đọc được (để hiện tên trong task/outlet...). Tự tạo hồ sơ của
    // chính mình với vai trò SALE khi lần đầu đăng nhập; chỉ Leader mới mời/sửa/xoá
    // người khác hoặc đổi vai trò.
    match /users/{email} {
      allow read: if isSapo();
      allow create: if isLeader()
        || (isSapo() && email == myEmail() && !userExists() && request.resource.data.role == 'SALE');
      allow update, delete: if isLeader();
    }

    match /tasks/{id} {
      allow read: if isUser();
      allow create: if isUser();
      allow update: if isUser() && (isLeader() || resource.data.assigneeEmail == myEmail() || resource.data.createdBy == myEmail());
      allow delete: if isLeader();
    }

    match /customers/{id} {
      allow read, create, update: if isUser();
      allow delete: if isLeader();
    }

    match /dailyLogs/{id} {
      allow read, create, update: if isUser() && (isLeader() || id.split('|')[0] == myEmail());
    }

    match /outlets/{id} {
      allow read: if isUser() && (isLeader() || resource.data.ownerEmail == myEmail());
      allow create: if isUser() && (isLeader() || request.resource.data.ownerEmail == myEmail());
      allow update: if isUser() && (
        isLeader() ||
        (resource.data.ownerEmail == myEmail() && request.resource.data.ownerEmail == resource.data.ownerEmail)
      );
      allow delete: if isLeader();
    }

    match /visits/{id} {
      allow read: if isUser() && (
        isLeader() ||
        resource.data.userEmail == myEmail() ||
        get(/databases/$(database)/documents/outlets/$(resource.data.outletId)).data.ownerEmail == myEmail()
      );
      allow create: if isUser() && request.resource.data.userEmail == myEmail();
    }
  }
}
